{
  "name": "booking-platform-root",
  "version": "1.0.0",
  "description": "AETHER - Ultra-Luxury Multi-Service Booking Platform",
  "scripts": {
    "build": "echo 'Deploying static Aether platform'",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:push": "npm run prisma:migrate --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "db:studio": "npm run prisma:studio --prefix backend"
  }
}
